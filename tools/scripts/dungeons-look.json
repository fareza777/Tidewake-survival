 },
 {
  "eval": "(() => { const g = __game.scene.getScene('Game'); const d = { ...g.session.dungeons }; for (const k of ['frostcave','magmaforge','drownedcrypt']) d[k] = { ...d[k], boss: true }; g.session = { ...g.session, dungeons: d }; return 1; })()"
 },
 {
  "eval": "(() => { const g = __game.scene.getScene('Game'); g.setSail('frost'); return 1; })()"
 },
 {
  "until": "__game.scene.isActive('Game') && __game.scene.getScene('Game').session.island === 'frost' && !__game.scene.getScene('Game').session.location",
  "timeout": 20000
 },
 {
  "wait": 800
 },
 {
  "eval": "(() => { const g = __game.scene.getScene('Game'); const l = g.world.landmarks.find((x) => x.id !== 'start' && x.id !== 'dock'); g.pos = { x: l.x + 0.5, y: l.y - 0.5 }; g.player.facing = 'down'; return JSON.stringify(l); })()"
 },
