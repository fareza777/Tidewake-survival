  "timeout": 20000
 },
 {
  "wait": 800
 },
 {
  "eval": "__game.scene.getScene('Hud').openMenu()"
 },
 {
  "wait": 300
 },
 {
  "eval": "JSON.stringify(__game.scene.getScene('Game').session.clock)"
 },
 {
  "wait": 1500
 },
 {
  "eval": "JSON.stringify(__game.scene.getScene('Game').session.clock)"
 },
 {
  "eval": "'Game paused: ' + __game.scene.isPaused('Game')"
 },
 {
  "shot": "pause-menu"
 },
 {
  "eval": "JSON.stringify(window.__errs)"
 }
]