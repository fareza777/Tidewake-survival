[
  {
    "goto": "http://localhost:5199/"
  },
  {
    "eval": "localStorage.clear(); localStorage.setItem('tidewake.onboarded', '1'); localStorage.setItem('tidewake.slot.0', '{broken'); localStorage.setItem('tidewake.slot.0.bak', 'nope')"
  },
  {
    "goto": "http://localhost:5199/"
  },
  {
    "until": "window.__game && __game.scene.isActive('Menu')",
