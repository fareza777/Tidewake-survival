  },
  {
    "wait": 800
  },
  {
    "shot": "menu-corrupt"
  },
  {
    "eval": "__game.scene.getScene('Menu').goTo('Game', {slot: 0})"
  },
  {
    "wait": 1500
  },
  {
    "eval": "'Back at menu: ' + __game.scene.isActive('Menu') + ', game running: ' + __game.scene.isActive('Game')"
  },
  {
    "eval": "JSON.stringify(window.__errs)"
  }
]
